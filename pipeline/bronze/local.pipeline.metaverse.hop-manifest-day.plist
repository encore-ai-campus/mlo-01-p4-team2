<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 메타버스 Bronze manifest 잡(MVR-2, 창 day) 매일 00:40Z(이 Mac 의 Asia/Seoul 로 09:40) — 로컬 시험대용 사용자 LaunchAgent 견본. 운영은 같은 잡을 ScheduledSparkApplication
     (concurrencyPolicy: Forbid, schedule 은 UTC, 환경 HOP_SOURCE=METAVERSE)으로. 00:40Z 는 광고 하루 잡(00:35Z) 뒤다(MVR-2 계획 V4 (가)).
     StartCalendarInterval 은 이 Mac 의 현지 시각이다 — 하루 주기는 UTC 로 정의하므로 시간대가 Asia/Seoul(UTC+9)이 아니면 Hour 를 바꾼다.
     설치는 사용자 승인 뒤: 자리 표시 두 가지(__REPO__ = 저장소 경로, __HOME__ = 홈 폴더)를 이 장치에 맞게 바꿔 ~/Library/LaunchAgents/ 에 두고
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.pipeline.metaverse.hop-manifest-day.plist
     제거: launchctl bootout gui/$(id -u)/local.pipeline.metaverse.hop-manifest-day 뒤 파일 삭제. 상태: launchctl print gui/$(id -u)/local.pipeline.metaverse.hop-manifest-day
     같은 창 크기 메타버스 잡이 아직 돌고 있으면 잠금이 그 회차를 건너뛴다(rc 75). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.pipeline.metaverse.hop-manifest-day</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/pipeline/bronze/run-hop-manifest-metaverse.sh</string>
    <string>day</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pipeline-metaverse-hop-manifest-day.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pipeline-metaverse-hop-manifest-day.log</string>
</dict>
</plist>
