{
  "name": "ads-outbox-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "127.0.0.1",
    "database.port": "5010",
    "database.dbname": "ads_pipeline_lab",
    "database.user": "ads_cdc",
    "database.password": "${file:/opt/kafka/connect/config/secrets/ads-cdc.properties:password}",
    "topic.prefix": "ads",
    "plugin.name": "pgoutput",
    "slot.name": "ads_outbox_slot",
    "slot.failover": "true",
    "publication.name": "ads_outbox_pub",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "public.events_outbox",
    "column.include.list": "public\\.events_outbox\\.(event_id|event_name|schema_version|aggregate_id|payload|created_at)",
    "message.key.columns": "public.events_outbox:aggregate_id",
    "snapshot.mode": "no_data",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT pg_logical_emit_message(false, 'debezium-heartbeat', now()::text)",
    "message.prefix.exclude.list": "debezium-heartbeat",
    "exactly.once.support": "required",
    "transaction.boundary": "poll",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "ads\\.public\\.events_outbox",
    "transforms.route.replacement": "ads.outbox.events",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "none"
  }
}
