<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 메타버스 창 대사(MVR-2, 창 hour) 매시 :17(메타버스 시간 잡 :15 뒤 — 계획 V4 (가)) — 로컬 시험대용 사용자 LaunchAgent 견본. 운영은 같은 도구를 대사 장치의 예약(UTC)으로(P8-2).
     설치는 사용자 승인 뒤: 자리 표시 두 가지(__REPO__ = 저장소 경로, __HOME__ = 홈 폴더)를 바꿔 ~/Library/LaunchAgents/ 에 두고
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.pipeline.metaverse.hop-reconcile-hour.plist
     손으로 한 번: launchctl kickstart gui/$(id -u)/local.pipeline.metaverse.hop-reconcile-hour. 제거: launchctl bootout gui/$(id -u)/local.pipeline.metaverse.hop-reconcile-hour 뒤 파일 삭제. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.pipeline.metaverse.hop-reconcile-hour</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/pipeline/reconcile/run-reconcile-metaverse.sh</string>
    <string>hour</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>17</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pipeline-metaverse-hop-reconcile-hour.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pipeline-metaverse-hop-reconcile-hour.log</string>
</dict>
</plist>
