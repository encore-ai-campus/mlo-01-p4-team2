<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 메타버스 Silver 잡(세대 2 — MVR-3a 원천 열 이름 outbox_uuid. 세대 1은 SL-5, 옛 이름) 매시 :10 — 로컬 시험대용 사용자 LaunchAgent 견본. 운영은 같은 잡을 ScheduledSparkApplication(schedule "10 * * * *",
     concurrencyPolicy: Forbid — 운영은 래퍼를 거치지 않는다)으로. :10 은 광고 manifest(:05)·대사(:07)와 메타버스 manifest(:15)·대사(:17) 사이다(15 §7).
     설치는 새 이름 Bronze 경로를 래퍼에 넣은 커밋 뒤, 사용자 승인 뒤(pipeline/runbooks/silver.md): 자리 표시 셋(__REPO__ = 실행 전용 코드 사본 경로 — 작업 저장소가 아님, __COMMIT__ = 그 사본이 돌
     커밋 40자, __HOME__ = 홈 폴더)을 이 장치에 맞게 바꿔 ~/Library/LaunchAgents/ 에 두고
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.pipeline.silver-metaverse.plist
     제거: launchctl bootout gui/$(id -u)/local.pipeline.silver-metaverse 뒤 파일 삭제. 상태: launchctl print gui/$(id -u)/local.pipeline.silver-metaverse
     앞 회차가 아직 돌고 있으면 잠금이 이 회차를 건너뛴다(rc 75). 사본 HEAD 가 __COMMIT__ 과 다르거나 사본이 더러우면 돌지 않는다(rc 2). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.pipeline.silver-metaverse</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/pipeline/silver/run-silver.sh</string>
    <string>metaverse</string>
    <string>2</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SILVER_CODE_COMMIT</key><string>__COMMIT__</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pipeline-silver-metaverse.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pipeline-silver-metaverse.log</string>
</dict>
</plist>
