# Backend owns auth, DB and Kafka. Include the public frontend host here.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional absolute path containing existing db.sqlite3 and var/.
# CAMPUS_DATA_DIR=C:/path/to/existing-data

# PostgreSQL is the platform database. SQLite/MySQL connections are retained only for legacy export.
DATABASE_ENGINE=postgresql

# Optional Redis: one shared address, or two role addresses on every backend/jobs process.
# CAMPUS_REDIS_URL=redis://shared-redis.internal:6379/0
# Role addresses override the shared fallback when non-empty.
# CAMPUS_MOVEMENT_REDIS_URL=redis://movement-redis.internal:6379/0
# CAMPUS_SERVICE_REDIS_URL=redis://service-redis.internal:6379/0

# Set these when using the team's operating PostgreSQL database.
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=playdata_platform
# POSTGRES_USER=platform_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# 프로세스별 연결 풀 상한. 기본 10, 0은 풀 미사용.
# POSTGRES_POOL_MAX_SIZE=10



# Actual rewards for each correct answer; restart the backend after changes.
LEARNING_POINTS_BEGINNER=20
LEARNING_POINTS_INTERMEDIATE=50
LEARNING_POINTS_ADVANCED=80

# Existing product policy: fixed 8-hour maximum and 30-minute idle expiry.
CAMPUS_LOGIN_MAX_AGE_SECONDS=28800
CAMPUS_LOGIN_IDLE_TIMEOUT_SECONDS=1800

# Private mailbox for registered accounts. Enable after migrations.
CAMPUS_DM_ENABLED=0

# 광고 서버와 슬롯을 준비한 뒤 활성화한다.
ADS_ENABLED=0
ADS_API_BASE_URL=
ADS_MEDIA_KEY=
# 별도 포털 매체 사용 시 두 항목을 함께 설정한다. 과거 슬롯 ID도 목록에 남긴다.
ADS_PORTAL_MEDIA_KEY=
ADS_PORTAL_MEDIA_SLOT_IDS=
ADS_SUBJECT_SECRET=
ADS_API_TIMEOUT=1
# 옥상은 shared, 포털 좌우는 individual 슬롯 UUID를 사용한다.
ADS_ROOFTOP_SLOT_ID=
ADS_PORTAL_LEFT_SLOT_ID=
ADS_PORTAL_RIGHT_SLOT_ID=
