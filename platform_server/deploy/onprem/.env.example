# Copy to deploy/onprem/.env on each PC. Replace credentials and private addresses.
# Both PCs use the same backend secret and external PostgreSQL database.
DJANGO_SECRET_KEY=replace-with-a-long-random-backend-key-shared-by-both-PCs
FRONTEND_SECRET_KEY=replace-with-a-long-random-frontend-key
DJANGO_ALLOWED_HOSTS=platform.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.example.com
FRONTEND_ALLOWED_HOSTS=platform.example.com,localhost,127.0.0.1

POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432
POSTGRES_DB=playdata_campus
POSTGRES_USER=platform_app
POSTGRES_PASSWORD=replace-with-the-external-database-password
# 4+4 앱과 jobs 1개의 풀 상한 합계는 90개다. 관리용 연결 여유도 확보한다.
POSTGRES_POOL_MAX_SIZE=10

# Existing code requires both stores from both PCs and service jobs.
# Each URL must name the same physical Redis store on both PCs.
# Use reachable private PC addresses, not each PC's own loopback address.
# URL-encode passwords. Configure native Redis authentication separately.
CAMPUS_MOVEMENT_REDIS_URL=redis://default:replace-with-movement-password@192.168.10.11:6379/0
CAMPUS_SERVICE_REDIS_URL=redis://default:replace-with-service-password@192.168.10.12:6379/0

# Optional: absolute existing data directory, shared by service workers and jobs.
# Leave unset to retain backend/var data paths.
# CAMPUS_DATA_DIR=/home/platform/playdatametaverse/backend

CAMPUS_DM_ENABLED=1
