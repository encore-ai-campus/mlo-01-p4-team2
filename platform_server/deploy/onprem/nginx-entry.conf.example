worker_processes 1;
pid "@RUNTIME@/entry.pid";
error_log stderr;
events { worker_connections 8192; }
http {
    access_log "@RUNTIME@/entry-access.log";
    upstream service_frontend {
        server @SERVICE_HOST@:@SERVICE_FRONTEND_PORT@;
        keepalive 128;
        keepalive_timeout 30s;
        keepalive_requests 1000;
    }
    upstream service_ingress {
        server @SERVICE_HOST@:@SERVICE_NGINX_PORT@;
        keepalive 128;
        keepalive_timeout 30s;
        keepalive_requests 1000;
    }
    map $http_upgrade $connection_upgrade { default upgrade; '' ""; }
    server {
        listen @BIND@:@ENTRY_PORT@;
        client_max_body_size 1m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        location = /ws/movement/ { proxy_pass http://@MOVEMENT_HOST@:@MOVEMENT_NGINX_PORT@; }
        location = /ws/chat/ { proxy_pass http://service_ingress; }
        location = /ws/campus/ { return 404; }
        location /static/ { proxy_pass http://service_ingress; }
        location / { proxy_pass http://service_frontend; }
    }
}
