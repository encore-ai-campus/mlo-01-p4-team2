[Unit]
Description=Playdata movement process on port %i
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/backend
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_DEBUG=0
EnvironmentFile=/home/ubuntu/backend/.env
ExecStart=/usr/bin/env DATABASE_ENGINE=postgresql /home/ubuntu/backend/.venv/bin/daphne -b 127.0.0.1 -p %i config.movement_asgi:application
Restart=always
RestartSec=2
UMask=0027

[Install]
WantedBy=multi-user.target
