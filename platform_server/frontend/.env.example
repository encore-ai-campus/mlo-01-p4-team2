FRONTEND_DEBUG=1
FRONTEND_SECRET_KEY=replace-for-deployment
FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_URL=http://127.0.0.1:9003
# Optional: a separate movement server. Defaults to BACKEND_URL.
MOVEMENT_BACKEND_URL=http://127.0.0.1:9003
BACKEND_TIMEOUT=30

# Reuse fully-read HTTP connections. Set 0 only for rollback/comparison.
BACKEND_HTTP_KEEPALIVE=1
BACKEND_HTTP_POOL_MAXSIZE=100
BACKEND_HTTP_IDLE_TIMEOUT=20
